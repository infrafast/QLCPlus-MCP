# MCP Transport mode (stdio or http)
MCP_TRANSPORT=http

# HTTP Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8788
HTTP_MCP_PATH=/mcp

# Authentication
MCP_AUTH_MODE=none
# MCP_AUTH_MODE=bearer
# MCP_AUTH_TOKEN=change-me

# QLC+ Configuration
# Use the QLC+ host reachable from where this server runs.
# For Docker/Synology, this is usually the LAN IP of the QLC+ machine.
QLC_HOST=127.0.0.1
QLC_OSC_INPUT_PORT=7700
QLC_OSC_OUTPUT_PORT=9000
QLC_UNIVERSE=1

# QLC+ 5 Native Server migration client (requires a build compatible with 984f0e7)
# Milestone 1 observes connection/inventory only; OSC remains the command path.
QLC_NATIVE_ENABLED=true
QLC_NATIVE_HOST=127.0.0.1
QLC_NATIVE_PORT=9998
QLC_NATIVE_ENCRYPTION_KEY=
QLC_NATIVE_RECONNECT_MS=2000
QLC_NATIVE_CONNECT_TIMEOUT_MS=10000
QLC_NATIVE_MAX_PROJECT_SIZE=16777216
QLC_NATIVE_CLIENT_NAME=QLCPlus-MCP

# Widget Configuration
# Use /config/widgets.json when running in Docker with ./config mounted to /config.
QLC_WIDGETS_FILE=config/widgets.json
QLC_ALLOW_RAW_OSC=false

# Dry Run Mode (logs OSC commands without sending)
QLC_DRY_RUN=false

# Logging
LOG_LEVEL=info
NODE_ENV=development
