# MCP transport: stdio or http
MCP_TRANSPORT=http

# HTTP server. Keep loopback for local-only use.
# Set HTTP_HOST=0.0.0.0 only when remote access is required.
HTTP_HOST=127.0.0.1
HTTP_PORT=8788
HTTP_MCP_PATH=/mcp

# HTTP authentication.
# For any non-loopback HTTP deployment, bearer auth is strongly recommended.
MCP_AUTH_MODE=none
# MCP_AUTH_MODE=bearer
# MCP_AUTH_TOKEN=replace-with-a-long-random-token

# QLC+ 5 Native Server
QLC_NATIVE_ENABLED=true
QLC_NATIVE_HOST=127.0.0.1
QLC_NATIVE_PORT=9998
QLC_NATIVE_ENCRYPTION_KEY=
QLC_NATIVE_RECONNECT_MS=2000
QLC_NATIVE_CONNECT_TIMEOUT_MS=10000
QLC_NATIVE_MAX_PROJECT_SIZE=16777216
QLC_NATIVE_CLIENT_NAME=QLCPlus-MCP

# Dry run: do not open a QLC+ native socket and do not send actions.
QLC_DRY_RUN=false

# Prompt override (optional)
# MCP_PROMPT_FILE=/absolute/path/to/PROMPT.md

# Logging
LOG_LEVEL=info
NODE_ENV=development
